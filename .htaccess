# CertiSub Assistant — ochrona plików wewnętrznych.
#
# Katalog projektu jest jednocześnie katalogiem publicznym serwera, więc przez HTTP
# udostępniamy tylko punkty wejścia (index.php, login.php, register.php, logout.php,
# dashboard*.php, api/) i skrypty interfejsu (assets/). Wszystko inne — kod, konfiguracja, logi, baza, skrypty CLI,
# testy, dokumentacja i repozytorium git — jest blokowane.
#
# Docelowo (patrz docs/MAPA_PROJEKTU.md) katalogiem głównym serwera powinien być
# osobny katalog public/ — wtedy ten plik przestanie być potrzebny.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Katalogi wewnętrzne (wzorce są względne do tego katalogu, więc działają
    # także wtedy, gdy aplikacja stoi w podkatalogu serwera).
    RewriteRule ^(classes|config|cron|database|docs|includes|lang|logs|scripts|storage|tests|vendor)(/|$) - [F,L]

    # Pliki i katalogi ukryte: .git, .gitignore, .php-cs-fixer.dist.php, .phpunit.cache…
    RewriteRule (^|/)\. - [F,L]

    # Metadane projektu w katalogu głównym
    RewriteRule ^(bootstrap\.php|composer\.(json|lock)|package(-lock)?\.json|tailwind\.config\.js|phpstan\.neon|phpunit\.xml(\.dist)?|CLAUDE\.md|README\.md)$ - [F,L]
    RewriteRule ^node_modules(/|$) - [F,L]
</IfModule>

# Zabezpieczenie na wypadek wyłączonego mod_rewrite — blokada typów plików,
# które nigdy nie powinny być pobierane przez przeglądarkę.
<FilesMatch "\.(dist|example|ini|lock|log|md|neon|sql|ya?ml)$">
    Require all denied
</FilesMatch>

# Pamięć podręczna przeglądarki (§2.5): zasoby mają wersję w adresie (?v=czas zmiany pliku),
# więc mogą leżeć w cache rok; strony i API z danymi osobowymi — nigdy.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2?|png|jpe?g|gif|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.php$">
        Header set Cache-Control "no-store"
    </FilesMatch>
</IfModule>
